+/** The transformer amps a satellite bank counts (power.ts `TRANSFORMER_AMPS_OUT` / `_AMPS_IN`, private there). */
+const SAT_AMPS_OUT = 4, SAT_AMPS_IN = 2;
+type Head = { runs: readonly Run[]; banks: readonly Bank[]; headX: number };
