+/**
+ * SP-M (spike, RUK-3058): re-lay the best line (`best`) with its machines reordered within a feed tier, as extra
+ * `Reordered` candidates with the same `westUnits`, `stack` and `packed` as the best line, pushed onto `lines`/`kinds`/`lays`.
+ * O2 (same fluid side by side): one extra line, its units grouped by shared fluid within each tier.
+ */
+function reorderBest(input: LocalInput, best: number,
+  lines: LocalLine[], kinds: Array<Pick<LayoutCandidate, 'kind' | 'westUnits'>>,
+  lays: Array<{ westUnits: number; stack: boolean; packed: boolean | 'own' | 'open' }>): void {
+  const lay = lays[best]!;
+  const reordered = spmReorder(input.units, input.stages?.supplyTier, spmFluidGroups(input.plan));
+  lines.push(buildLocalAt({ ...input, units: reordered }, lay.westUnits, lay.stack, lay.packed));
+  kinds.push({ kind: CandidateKind.Reordered, westUnits: lay.westUnits });
+  lays.push(lay);
+}
