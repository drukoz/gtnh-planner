+/** SP-M (spike, RUK-3058): the feed tier a unit is placed at (`placeUnits`'s `min(tier, supplyTier)`), null when it is not fed. */
+function spmFeedTier(u: Unit, supplyTier: number | undefined): number | null {
+  return supplyTier === undefined || !u.electric ? null : Math.min(u.tier, supplyTier);
+}
+
+/**
+ * SP-M (spike, RUK-3058): `units` with each feed tier's electric, non-manual units put in the order `permute` gives
+ * them, every other unit (steam, run by hand) left in its place. Feeding the result to `buildLocalAt` keeps the tier
+ * grouping (`lowestFeedFirst`), so only the order within a tier changes.
+ */
+function spmReorder(units: readonly Unit[], supplyTier: number | undefined, permute: (us: Unit[]) => Unit[]): Unit[] {
+  const slots = new Set<number>();
+  const groups = new Map<number, Unit[]>();
+  for (let i = 0; i < units.length; i++) {
+    const u = units[i]!;
+    if (!u.electric || u.manual !== undefined) continue;
+    slots.add(i);
+    const t = spmFeedTier(u, supplyTier)!;
+    const g = groups.get(t);
+    if (g === undefined) groups.set(t, [u]);
+    else g.push(u);
+  }
+  const ordered = new Map<number, Unit[]>();
+  for (const [t, us] of groups) ordered.set(t, permute(us));
+  const cursor = new Map<number, number>();
+  for (const t of groups.keys()) cursor.set(t, 0);
+  return units.map((u, i) => {
+    if (!slots.has(i)) return u;
+    const t = spmFeedTier(u, supplyTier)!;
+    const g = ordered.get(t)!;
+    const k = cursor.get(t)!;
+    cursor.set(t, k + 1);
+    return g[k]!;
+  });
+}
+
+/** SP-M (spike, RUK-3058) O1: within a feed tier, the hungriest machine first (stable, so ties keep flow order). */
+function spmHungriestFirst(units: readonly Unit[]): Unit[] {
+  return [...units].sort((a, b) => b.euPerTick - a.euPerTick);
+}
+
+/**
+ * SP-M (spike, RUK-3058): the fluids a step takes or makes (its `inputs`/`outputs` keys starting `fluid:`, as
+ * `layout.test.ts`'s `fluidsOf`).
+ */
+function spmFluids(plan: Plan, stepId: string): string[] {
+  const s = plan.steps.find((x) => x.id === stepId);
+  return s === undefined ? [] : [...new Set([...s.inputs, ...s.outputs].map((p) => p.key).filter((k) => k.startsWith('fluid:')))];
+}
+
+/**
+ * SP-M (spike, RUK-3058) O2: within a feed tier, group units whose steps share a fluid (transitively), order the groups
+ * by first appearance and keep flow order inside a group. A unit with no fluid is a group of its own.
+ */
+function spmFluidGroups(plan: Plan) {
+  return (units: readonly Unit[]): Unit[] => {
+    const parent = units.map((_, i) => i);
+    const find = (i: number): number => {
+      while (parent[i] !== i) {
+        parent[i] = parent[parent[i]!]!;
+        i = parent[i]!;
+      }
+      return i;
+    };
+    const fluidTo = new Map<string, number>();
+    units.forEach((u, i) => {
+      for (const f of spmFluids(plan, u.stepId)) {
+        const j = fluidTo.get(f);
+        if (j === undefined) fluidTo.set(f, i);
+        else {
+          const ra = find(j);
+          const rb = find(i);
+          if (ra !== rb) parent[rb] = ra;
+        }
+      }
+    });
+    const clusters = new Map<number, Unit[]>();
+    const first = new Map<number, number>();
+    units.forEach((u, i) => {
+      const r = find(i);
+      const c = clusters.get(r);
+      if (c === undefined) {
+        clusters.set(r, [u]);
+        first.set(r, i);
+      } else c.push(u);
+    });
+    return [...clusters.keys()].sort((a, b) => first.get(a)! - first.get(b)!).flatMap((r) => clusters.get(r)!);
+  };
+}
