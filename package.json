{
  "name": "gtnh-planner",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*"
  },
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "dev:server": "node --watch --disable-warning=ExperimentalWarning src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "test": "tsc -b && vitest run",
    "e2e": "vite build && playwright test",
    "pack:info": "node --disable-warning=ExperimentalWarning src/server/cli/pack-info.ts",
    "set-password": "node --disable-warning=ExperimentalWarning src/server/cli/set-password.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "elkjs": "0.12.0",
    "highs": "1.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
